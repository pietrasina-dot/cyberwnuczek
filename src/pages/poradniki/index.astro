---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { breadcrumbSchema, jsonLd } from '../../lib/schema';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Poradniki"
  description="Wszystkie poradniki CyberWnuczka: oszustwa, hasła, bankowość i smartfon."
  canonicalPath="/poradniki"
  jsonLd={jsonLd(
    breadcrumbSchema([
      { name: 'Strona główna', path: '/' },
      { name: 'Poradniki', path: '/poradniki' },
    ]),
  )}
>
  <Breadcrumbs items={[{ name: 'Strona główna', path: '/' }, { name: 'Poradniki' }]} />
  <section class="hero">
    <h1>Poradniki</h1>
    <p class="lede">Krótkie instrukcje, które da się zastosować od razu.</p>
  </section>
  <section class="article-list">
    {articles.map((article) => <ArticleCard article={article} />)}
  </section>
</BaseLayout>
