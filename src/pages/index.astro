---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import GraphicSlider from '../components/GraphicSlider.astro';
import { SITE, TOPICS, topicPath } from '../lib/site';
import { jsonLd, webPageSchema } from '../lib/schema';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredImage = articles.find((article) => article.data.image);
---

<BaseLayout
  title={SITE.homeTitle}
  description={SITE.description}
  canonicalPath="/"
  ogImage={featuredImage?.data.image}
  ogImageAlt={featuredImage?.data.imageAlt}
  jsonLd={jsonLd(
    webPageSchema({
      name: SITE.homeTitle,
      description: SITE.description,
      path: '/',
    }),
  )}
>
  <GraphicSlider articles={articles} />
  <section class="hero">
    <p class="eyebrow">Poradniki o bezpieczeństwie w internecie</p>
    <h1>Internet bez paniki.</h1>
    <p class="lede">{SITE.tagline}</p>
    <p>
      CyberWnuczek to zbiór krótkich poradników o oszustwach internetowych, hasłach,
      bankowości online i smartfonie, napisanych tak, żeby dało się z nich skorzystać
      od razu.
    </p>
    <p class="hero__actions">
      <a class="button" href="#tematy">Zacznij od tematu</a>
      <a class="button button--ghost" href="/poradniki">Wszystkie poradniki</a>
    </p>
  </section>

  <section class="section" aria-labelledby="tematy">
    <h2 id="tematy">Zacznij od tematu</h2>
    <div class="grid">
      {
        Object.entries(TOPICS).map(([id, topic]) => (
          <a class="card card--topic" href={topicPath(id as keyof typeof TOPICS)}>
            <h3>{topic.title}</h3>
            <p>{topic.description}</p>
            <span class="card__more">Otwórz temat</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="article-list" aria-labelledby="najnowsze">
    <h2 id="najnowsze">Najnowsze poradniki</h2>
    <div class="article-list__items">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
    <p>
      <a class="button button--ghost" href="/poradniki">Wszystkie poradniki</a>
    </p>
  </section>
</BaseLayout>
