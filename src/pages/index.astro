---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, TOPICS, topicPath } from '../lib/site';
import { jsonLd, websiteSchema } from '../lib/schema';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  canonicalPath="/"
  jsonLd={jsonLd(websiteSchema())}
>
  <section class="hero">
    <h1>Internet bez paniki.</h1>
    <p class="lede">{SITE.tagline}</p>
    <p>
      Tu znajdziesz krótkie instrukcje: co kliknąć, czego nie klikać i kiedy po prostu
      odłożyć telefon.
    </p>
  </section>

  <section aria-labelledby="tematy">
    <h2 id="tematy">Zacznij od tematu</h2>
    <div class="grid">
      {
        Object.entries(TOPICS).map(([id, topic]) => (
          <a class="card" href={topicPath(id as keyof typeof TOPICS)}>
            <h3>{topic.title}</h3>
            <p>{topic.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="article-list" aria-labelledby="najnowsze">
    <h2 id="najnowsze">Najnowsze poradniki</h2>
    {articles.map((article) => <ArticleCard article={article} />)}
    <p><a href="/poradniki">Wszystkie poradniki</a></p>
  </section>
</BaseLayout>
