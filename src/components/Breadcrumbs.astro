---
type Crumb = {
  name: string;
  path?: string;
};

const { items } = Astro.props as { items: Crumb[] };
---

<nav class="breadcrumbs" aria-label="Okruszki">
  {
    items.map((item, index) => (
      <>
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.path ? <a href={item.path}>{item.name}</a> : <span>{item.name}</span>}
      </>
    ))
  }
</nav>
