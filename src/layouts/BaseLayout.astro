---
import '../styles/global.css';
import { MAIN_NAV, SITE, documentTitle } from '../lib/site';
import { globalSchema, jsonLd as toJsonLd } from '../lib/schema';

type Props = {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
};

const {
  title,
  description,
  canonicalPath,
  jsonLd,
  noindex = false,
  ogType = 'website',
  ogImage,
  ogImageAlt,
} = Astro.props;
const ogImageUrl = ogImage ? new URL(ogImage, SITE.url).toString() : undefined;

const pageTitle = documentTitle(title);
const canonical = new URL(canonicalPath, SITE.url).toString();
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const globalJsonLd = toJsonLd(globalSchema());

function isCurrent(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={ogImageUrl} />
        </>
      )
    }
    {!ogImageUrl && <meta name="twitter:card" content="summary" />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <script type="application/ld+json" set:html={globalJsonLd} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href="/">
          <img
            class="logo__mark"
            src="/favicon.svg"
            width="48"
            height="48"
            alt=""
            aria-hidden="true"
          />
          <span>{SITE.name}</span>
        </a>
        <nav class="nav" aria-label="Główne">
          {
            MAIN_NAV.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="tresc" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__name">{SITE.name}</p>
          <p>{SITE.tagline}</p>
        </div>
        <nav class="site-footer__nav" aria-label="Stopka">
          <a href="/">Strona główna</a>
          <a href="/poradniki">Poradniki</a>
          <a href="/o-mnie">O stronie</a>
          <a href="/polityka-prywatnosci">Prywatność</a>
          <a href="/nota-prawna">Nota prawna</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="site-footer__note">Nie zbieramy maili. Nie ma newslettera.</p>
      </div>
    </footer>
  </body>
</html>
